# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medivanta

# JWT
JWT_SECRET=medivanta-jwt-secret-change-in-production
JWT_REFRESH_SECRET=medivanta-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173

# SMTP (Email reminders — Phase 5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Groq API (Chatbot upgrade — Phase 6)
GROQ_API_KEY=
